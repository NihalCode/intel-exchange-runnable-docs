{
  "description": "Paths and globs that must never appear in source archives or release artifacts",
  "forbiddenGlobs": [
    ".env",
    ".env.*",
    "!.env.example",
    ".data/**",
    "*.db",
    "*.db-journal",
    ".git/**",
    ".next/**",
    "node_modules/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**",
    "blob-report/**",
    ".tmp/**",
    ".tmp-app-build/**",
    ".vercel/**",
    ".cursor/**",
    "**/*.pem",
    "**/*secret*",
    "**/*credential*.json",
    "**/CYWARE KEYS.txt",
    "**/.cyware-keys.txt",
    "logs/**",
    "**/*.log",
    "tsconfig.tsbuildinfo"
  ],
  "allowedRootEntries": [
    ".env.example",
    ".gitignore",
    ".nvmrc",
    "AGENTS.md",
    "AGENT.md",
    "CLAUDE.md",
    "DEVELOPER.md",
    "README.md",
    "docs",
    "e2e",
    "eslint.config.mjs",
    "next.config.ts",
    "package.json",
    "package-lock.json",
    "playwright.config.ts",
    "postcss.config.mjs",
    "public",
    "scripts",
    "src",
    "tsconfig.json",
    "vercel.json",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
