{
  "name": "intel-exchange-runnable-docs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "chat:manifest": "node scripts/chat-accuracy/build-api-manifest.mjs",
    "chat:report": "node scripts/chat-accuracy/write-report.mjs",
    "chat:accuracy": "node scripts/chat-accuracy/run-harness.mjs",
    "build:index": "node scripts/build-agent-index.mjs",
    "pinecone:upsert": "node scripts/pinecone-upsert.mjs",
    "ingest": "node scripts/ingest.mjs",
    "ingest:all": "node scripts/ingest.mjs --product=ctix && node scripts/ingest.mjs --product=csap && node scripts/ingest.mjs --product=orchestrate && node scripts/ingest.mjs --product=cftr",
    "auth:diagnose": "tsx scripts/diagnose-auth.ts",
    "vercel:sync-product-env": "node scripts/vercel/sync-product-env.mjs",
    "security:scan-secrets": "node scripts/security/scan-secrets.mjs",
    "archive:check": "node scripts/security/check-archive.mjs",
    "health:scan": "node scripts/health/analyze.mjs",
    "health:check": "node scripts/health/analyze.mjs --check"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.24.0",
    "better-sqlite3": "^12.11.1",
    "graphql": "^16.14.0",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "next": "16.2.7",
    "pg": "^8.22.0",
    "postcss": "^8.5.15",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
