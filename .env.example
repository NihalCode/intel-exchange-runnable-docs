# Copy to .env.local and fill in. All values are read via process.env.
# .env* is gitignored — never commit real keys.

# --- OpenAI (server-side only — never use NEXT_PUBLIC_) ---
# Used by: agent chat/planning, embeddings, app edits, scripts/pinecone-upsert.mjs
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Pinecone (vector DB for RAG retrieval) ---
# If PINECONE_API_KEY is unset, the agent automatically falls back to the
# local BM25 lexical index (offline-safe; used in tests and during build).
PINECONE_API_KEY=
PINECONE_INDEX=cyware-api-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Multi-product configuration ---
DEFAULT_PRODUCT_ID=ctix

# Optional per-product docs URLs (used by ingestion scripts; defaults are in products-config.mjs)
# CTIX_DOCS_URL=https://ctixapiv3.cyware.com/intel-exchange-api-reference/intel-exchange-api-reference
# CSAP_DOCS_URL=https://csapapi.cyware.com/
# ORCHESTRATE_DOCS_URL=https://orchestrateapi.cyware.com/cyware-orchestrate-api-reference-theneo
# CFTR_DOCS_URL=https://cftrapi.cyware.com/

# --- Optional: local CTIX script testing (scripts/test-snippets.mjs, test-ping.mjs) ---
# CTIX_BASE_URL=https://cs-testv2.cyware.com/ctixapi
# CTIX_ACCESS_ID=
# CTIX_SECRET_KEY=
# CYWARE_KEYS_FILE=

# --- Developer / admin access (server-side only) ---
# Legacy bearer token for offline/dev workflows when AUTH_DISABLED=true.
# When Auth0 is enabled, developer routes use role-based view_technical_diagnostics.
DEVELOPER_ACCESS_TOKEN=

# --- Documentation workspace auth (Auth0) ---
# The documentation app (/, /docs, /guides, /changelog, agent, settings, admin)
# requires Auth0 authentication. Only auth UX routes (/sign-in, /access, /auth,
# /invite, /post-login) and health/session probe APIs are public.
# The AI agent additionally requires per-user product API credentials.
AUTH0_SECRET=
AUTH0_BASE_URL=
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ACTION_SHARED_SECRET=
APP_BASE_URL=
# Machine-to-machine Auth0 Management API client. Required for direct user provisioning.
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=
# Defaults to https://AUTH0_DOMAIN/api/v2/ when unset.
AUTH0_MANAGEMENT_AUDIENCE=
AUTH0_DATABASE_CONNECTION=
# Postgres required in production (Vercel). SQLite used locally when unset.
DATABASE_URL=
# Cold-start owner bootstrap (only when zero active users exist).
# Canonical: INITIAL_OWNER_EMAIL. Aliases: DOCUMENTATION_BOOTSTRAP_OWNER_EMAIL, INITIAL_ADMIN_EMAIL
INITIAL_OWNER_EMAIL=
# DOCUMENTATION_BOOTSTRAP_OWNER_EMAIL=
# INITIAL_ADMIN_EMAIL=
# Optional Auth0 connection names for login buttons
# AUTH0_GOOGLE_CONNECTION=google-oauth2
# AUTH0_EMAIL_CONNECTION=
# INVITE_DEFAULT_EXPIRY_DAYS=7
# INVITE_EMAIL_WORKSPACE_NAME=Cyware API Docs
# --- Invite emails (Resend — https://resend.com) ---
# When set, Send invite / Resend emails the invite link automatically.
RESEND_API_KEY=
INVITE_EMAIL_FROM=Cyware API Docs <invites@yourdomain.com>
# AUTH_DISABLED=true

# Required for Postman import API, diagnostics, and protected ingest routes.

# Server-side Cyware credentials for developer ingest validation (placeholders only here).
# Pattern: DEV_CYWARE_{PRODUCT}_{FIELD}
DEV_CYWARE_CTIX_BASE_URL=
DEV_CYWARE_CTIX_ACCESS_ID=
DEV_CYWARE_CTIX_SECRET_KEY=

DEV_CYWARE_CFTR_BASE_URL=
DEV_CYWARE_CFTR_ACCESS_ID=
DEV_CYWARE_CFTR_SECRET_KEY=

DEV_CYWARE_CSAP_BASE_URL=
DEV_CYWARE_CSAP_ACCESS_ID=
DEV_CYWARE_CSAP_SECRET_KEY=

DEV_CYWARE_ORCHESTRATE_BASE_URL=
DEV_CYWARE_ORCHESTRATE_ACCESS_ID=
DEV_CYWARE_ORCHESTRATE_SECRET_KEY=

# --- Public documentation vs live API UI ---
# Default (unset/false): clients see docs + placeholder code only; no credential UI.
# Set true only for developer testing in the main app shell.
# NEXT_PUBLIC_ENABLE_LIVE_API_UI=false

# --- API execution (server-side proxy) ---
# When false/unset, /api/run rejects live tenant calls (docs + agent still work).
# Set true only on developer/staging environments with tenant access.
# ENABLE_API_EXECUTION=false

# --- Ingestion limits ---
# MAX_CRAWL_PAGES=500
# REQUEST_TIMEOUT_MS=20000

# Cursor Pinecone MCP reads these from .env.local via .cursor/mcp.json (see Cursor Settings > MCP).

# --- Enterprise control plane (Documentation Agent admin) ---
# Optional rollout gate. When true, /admin layout requires Auth0 MFA claims
# (amr/acr). Keep false/unset until the production Auth0 tenant emits and has
# been validated for those claims; deployments never enable it automatically.
# Sensitive API mutations still enforce MFA via SENSITIVE_PERMISSIONS regardless.
# ADMIN_REQUIRE_MFA=false
# CSRF_SIGNING_SECRET=  # 32+ chars; falls back to AUTH0_SECRET when long enough
# Base64-encoded 32-byte AES key for per-user product credentials.
# Generate securely, for example: openssl rand -base64 32
DOCUMENTATION_CREDENTIAL_ENCRYPTION_KEY=
# CONTROL_PLANE_CRON_SECRET=  # Protects POST /api/admin/control-plane/jobs/process for schedulers
# VAULT_PROVIDER=env|hashicorp|aws  # Optional external secret storage for API keys
# VAULT_ADDR=  # HashiCorp Vault base URL (hashicorp provider)
# VAULT_TOKEN=  # HashiCorp Vault token (hashicorp provider)
# VAULT_MOUNT_PATH=secret  # KV mount path (hashicorp provider)
# AWS_REGION=us-east-1  # AWS Secrets Manager region (aws provider; SDK optional)

# --- Optional: demo mode (offline simulated API responses) ---
# NEXT_PUBLIC_DEMO_MODE=false

# --- Multi-domain routing (all default off; enable per staged rollout) ---
# DOMAIN_ROUTING_ENABLED=false
# SEPARATE_ADMIN_DOMAIN_ENABLED=false
# When true, /admin on product hosts redirects to ADMIN_DOMAIN (requires ADMIN_DOMAIN).
# Leave false on per-product Vercel projects so each deployment serves its own /admin.
# CROSS_DOMAIN_SSO_ENABLED=false
# QUERY_ANALYTICS_ENABLED=false
# CUSTOM_SNIPPET_QUERY_PARAMS_ENABLED=false
# CHAT_RESPONSE_NAVIGATION_ENABLED=false
# NEXT_PUBLIC_CUSTOM_SNIPPET_QUERY_PARAMS_ENABLED=false
# NEXT_PUBLIC_CHAT_RESPONSE_NAVIGATION_ENABLED=false
# CTIX_DOMAIN=docs-ctix.example.com
# CFTR_DOMAIN=docs-cftr.example.com
# CSAP_DOMAIN=docs-csap.example.com
# ORCHESTRATE_DOMAIN=docs-orchestrate.example.com
# ADMIN_DOMAIN=admin.example.com
# AUTH_DOMAIN=auth.example.com

# --- Per-product Vercel project (multi-project topology) ---
# APP_PRODUCT_ID=ctix
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROVIDER_FAKE=true
# APP_POSTMAN_COLLECTION_ID=
# APP_ENVIRONMENT=production
# APP_CANONICAL_DOMAIN=
# SEARCH_INDEX_NAME=
# Pinecone namespace for hard vector isolation per product deploy (e.g. product-ctix).
# When APP_PRODUCT_ID is set and VECTOR_NAMESPACE is unset, defaults to product-{APP_PRODUCT_ID}.
# VECTOR_NAMESPACE=
