# Copy to .env.local and fill in. All values are read via process.env.
# .env* is gitignored — never commit real keys.

# --- OpenAI (required for embeddings + LLM planning) ---
# Used by: scripts/pinecone-upsert.mjs, query-time embeddings, planWithLlm.
OPENAI_API_KEY=

# --- Pinecone (vector DB for RAG retrieval) ---
# If PINECONE_API_KEY is unset, the agent automatically falls back to the
# local BM25 lexical index (offline-safe; used in tests and during build).
PINECONE_API_KEY=
PINECONE_INDEX=intel-exchange-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Optional: demo mode (offline simulated API responses) ---
# NEXT_PUBLIC_DEMO_MODE=false
