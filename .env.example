# Copy to .env.local and fill in. All values are read via process.env.
# .env* is gitignored — never commit real keys.

# --- OpenAI (required for embeddings + LLM planning) ---
# Used by: scripts/pinecone-upsert.mjs, query-time embeddings, planWithLlm.
OPENAI_API_KEY=

# --- Pinecone (vector DB for RAG retrieval) ---
# If PINECONE_API_KEY is unset, the agent automatically falls back to the
# local BM25 lexical index (offline-safe; used in tests and during build).
PINECONE_API_KEY=
PINECONE_INDEX=cyware-api-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Multi-product configuration ---
DEFAULT_PRODUCT_ID=ctix

# Optional per-product docs URLs (used by ingestion scripts; defaults are in products-config.mjs)
# CTIX_DOCS_URL=https://ctixapiv3.cyware.com/intel-exchange-api-reference/intel-exchange-api-reference
# CSAP_DOCS_URL=https://csapapi.cyware.com/
# ORCHESTRATE_DOCS_URL=https://orchestrateapi.cyware.com/cyware-orchestrate-api-reference-theneo
# CFTR_DOCS_URL=https://cftrapi.cyware.com/

# --- API execution (server-side proxy) ---
# When false/unset, /api/run still works for docs browsing; set true in production tenants.
# ENABLE_API_EXECUTION=true

# --- Ingestion limits ---
# MAX_CRAWL_PAGES=500
# REQUEST_TIMEOUT_MS=20000

# Cursor Pinecone MCP reads these from .env.local via .cursor/mcp.json (see Cursor Settings > MCP).

# --- Optional: demo mode (offline simulated API responses) ---
# NEXT_PUBLIC_DEMO_MODE=false
